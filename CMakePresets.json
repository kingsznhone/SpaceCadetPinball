{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_WIN32_EXECUTABLE": "ON"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows 11 x64 (Visual Studio 2026 + vcpkg)",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-x64-vs2022",
      "displayName": "Windows 11 x64 (Visual Studio 2022 + vcpkg)",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "windows-x64-asan",
      "displayName": "Windows 11 x64 ASan/UBSan (Debug)",
      "inherits": "windows-x64",
      "cacheVariables": {
        "SCP_SANITIZE": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (Ninja, system SDL2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal arm64+x86_64 (system SDL2)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-vs2022-release",
      "configurePreset": "windows-x64-vs2022",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-asan-debug",
      "configurePreset": "windows-x64-asan",
      "configuration": "Debug"
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64"
    },
    {
      "name": "macos-universal-release",
      "configurePreset": "macos-universal"
    }
  ]
}
